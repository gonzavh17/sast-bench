# javascript-security-extended con las dos queries de la familia
# client-side-secrets reemplazadas por sus versiones extendidas. Todo lo demas
# corre igual, para que la fila codeql+ext sea comparable con la de codeql.
- description: javascript-security-extended + credenciales de sesion
- import: codeql-suites/javascript-security-extended.qls
  from: codeql/javascript-queries
- exclude:
    id:
      - js/clear-text-storage-of-sensitive-data
      - js/clear-text-logging
- queries: .
