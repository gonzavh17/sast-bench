# javascript-security-extended with the two client-side-secrets queries
# replaced by their extended versions. Everything else runs the same, so the
# codeql+ext row is comparable with the codeql one.
- description: javascript-security-extended + session credentials
- import: codeql-suites/javascript-security-extended.qls
  from: codeql/javascript-queries
- exclude:
    id:
      - js/clear-text-storage-of-sensitive-data
      - js/clear-text-logging
- queries: .
