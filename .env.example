# Copy to .env and fill in. .env is in .gitignore: it is never committed.
#
#   cp .env.example .env
#
# Needed by everything that calls the model: the phase 2 LLM arm and the
# phase 3 false-positive filter (runners/hybrid.py).
# The rule-based runners (Semgrep, CodeQL, ESLint) need none of this.

# Anthropic API key. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
